# ===== REQUIRED =====

# JWT_SECRET: Strong random value (32+ chars). Server refuses to start without it in production.
# Generate with: openssl rand -base64 48
JWT_SECRET="change-me-to-a-strong-random-value"

# JWT_EXPIRES_IN: Token lifetime (default "7d"). Accepts ms/s/m/h/d/y.
JWT_EXPIRES_IN="7d"

# SITE_ORIGIN: Public origin (no trailing slash) used for canonical/OG/JSON-LD,
# robots.txt and sitemap.xml. Defaults to https://womenplay.org.
SITE_ORIGIN="https://womenplay.org"

# GEMINI_API_KEY: Required for Gemini AI API calls.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="http://localhost:3000"

# ===== DATABASE (Supabase / Postgres) =====
# Default engine is Supabase. Set DATABASE_URL to your Supabase project's
# Postgres connection string (Dashboard > Settings > Database > Connection string).
# IMPORTANT: use the POOLER string (aws-0-REGION.pooler.supabase.com) — the
# "direct" host (db.PROJECT_REF.supabase.co) is IPv6-only. Append ?sslmode=require
# so the pooler's self-signed cert is accepted (the server honors it).
DATABASE_URL="postgresql://postgres.PROJECT_REF:YOUR_PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres?sslmode=require"

# Or configure individual Postgres parameters (alternative to DATABASE_URL):
DB_HOST="localhost"
DB_PORT="5432"
DB_USER="postgres"
DB_PASSWORD=""
DB_NAME="postgres"

# TLS for the database connection. Priority: DATABASE_URL sslmode → these env vars.
DB_SSL="true"
# When no sslmode is given and DB_SSL is true, "false" here accepts self-signed certs.
DB_SSL_REJECT_UNAUTHORIZED="false"

# DB_FILE: Local JSON file used when no DATABASE_URL/Postgres is configured (dev only).
# The JSON file is git-ignored and must NOT be shipped to production.
# DB_FILE="database.json"

# Supabase client keys (optional if you add the Supabase JS client later).
# Rotate the previously leaked keys in the Supabase dashboard and use new values here.
SUPABASE_URL="https://YOUR_PROJECT_REF.supabase.co"
SUPABASE_ANON_KEY="YOUR_ANON_KEY"
SUPABASE_SERVICE_ROLE_KEY="YOUR_SERVICE_ROLE_KEY"

# ===== CORS =====
# Comma-separated list of allowed browser origins (e.g. "https://womenplay.org,https://admin.womenplay.org").
# Empty: dev reflects any origin; PRODUCTION disables cross-origin browser requests (same-origin only).
CORS_ORIGIN="http://localhost:3000"

# ===== AUTH =====
# Default password assigned to seeded/legacy admin accounts (dev only).
# Change after first login. (In production, use the admin settings UI.)
DEFAULT_ADMIN_PASSWORD="WomenPlay@2026!"

# Max auth attempts per IP per 15 minutes (login/register/2FA/reset).
# Leave unset for the default of 20.
# AUTH_RATE_LIMIT_MAX="20"

# ===== STRIPE =====
# Live keys (production). Set STRIPE_MODE in the admin dashboard.
STRIPE_PUBLIC_KEY=""
STRIPE_SECRET_KEY=""
STRIPE_TEST_PUBLIC_KEY=""
STRIPE_TEST_SECRET_KEY=""
STRIPE_LIVE_PUBLIC_KEY=""
STRIPE_LIVE_SECRET_KEY=""

# STRIPE_WEBHOOK_SECRET: your_account webhook signing secret ("whsec_..."). Required for
# reliable confirmation of checkout.session.completed (launch tickets / event registrations).
# Set inside Stripe Dashboard > Developers > Webhooks, or via the admin Settings UI.
STRIPE_WEBHOOK_SECRET=""

# ===== SMTP (email delivery) =====
SMTP_HOST="mail.womenplay.org"
SMTP_PORT="465"
SMTP_USER="notifications@womenplay.org"
SMTP_PASS=""
SMTP_SECURE="true"
SMTP_FROM="notifications@womenplay.org"
# Set to "false" only for self-signed SMTP certs in dev.
SMTP_REJECT_UNAUTHORIZED="true"

# ===== SERVER =====
PORT="3000"
# Set to "production" for the production build.
NODE_ENV="development"
